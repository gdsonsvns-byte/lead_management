generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
}

enum FollowUpType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
  STATUS_CHANGE
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  SKIPPED
  CANCELLED
}

model Account {
  id             String  @id @default(uuid())
  businessName   String?
  phone          String?
  location       String?
  email          String  @unique
  whatsappApiKey String?
  users          User[]
  forms          Form[]

  createdAt       DateTime         @default(now())
  apiAccessTokens ApiAccessToken[]

  @@index([createdAt])
}

model User {
  id                  String           @id @default(uuid())
  name                String
  email               String           @unique
  password            String
  role                Role             @default(ADMIN)
  createdById         String?
  createdBy           User?            @relation("CreatedAdmins", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins       User[]           @relation("CreatedAdmins")
  accountId           String
  account             Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  managedUsers        ManagedUser[]
  forms               Form[]
  resetToken          String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime         @default(now())
  followUps           FollowUp[]
  apiAccessTokens     ApiAccessToken[]

  @@index([accountId])
  @@index([role])
  @@index([createdById])
  @@index([createdAt])
}

model ManagedUser {
  id        String   @id @default(uuid())
  adminId   String
  name      String
  email     String?
  phone     String?
  roleTitle String?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
}

model Form {
  id                        String      @id @default(uuid())
  formsId                   String
  userId                    String
  title                     String
  description               String?
  slug                      String      @unique
  fields                    FormField[]
  responses                 Response[]
  createdAt                 DateTime    @default(now())
  adminWhatsappCampaignName String?
  userWhatsappCampaignName  String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String?

  @@index([userId])
  @@index([accountId])
  @@index([createdAt])
}

model FormField {
  id              String           @id @default(uuid())
  formId          String
  label           String
  type            String
  options         Json?
  required        Boolean          @default(false)
  order           Int?
  form            Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  responseAnswers ResponseAnswer[]

  @@index([formId])
}

model Response {
  id          String           @id @default(uuid())
  formId      String
  submittedAt DateTime         @default(now())
  form        Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers     ResponseAnswer[]
  followUps   FollowUp[]

  @@index([formId])
  @@index([submittedAt])
}

model ResponseAnswer {
  id         String @id @default(uuid())
  responseId String
  fieldId    String
  value      String

  response Response  @relation(fields: [responseId], references: [id], onDelete: Cascade)
  field    FormField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([fieldId])
}

model FollowUp {
  id               String         @id @default(uuid())
  responseId       String
  addedByUserId    String
  note             String?
  type             FollowUpType   @default(NOTE)
  status           FollowUpStatus @default(PENDING)
  businessStatus   String         @default("Client will call")
  nextFollowUpDate DateTime?
  createdAt        DateTime       @default(now())
  response         Response       @relation(fields: [responseId], references: [id], onDelete: Cascade)
  addedBy          User           @relation(fields: [addedByUserId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([addedByUserId])
  @@index([status])
  @@index([type])
  @@index([nextFollowUpDate])
  @@index([createdAt])
  @@index([status, nextFollowUpDate])
}

model ApiAccessToken {
  id          String    @id @default(uuid())
  name        String
  tokenHash   String    @unique
  accountId   String
  createdById String
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  isRevoked   Boolean   @default(false)
  createdAt   DateTime  @default(now())

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([createdById])
  @@index([expiresAt])
}
